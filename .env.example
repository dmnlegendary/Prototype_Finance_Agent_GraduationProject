# Copia este archivo con el nombre ".env" (sin el .example) y llena tus datos.
# El archivo .env NUNCA se sube a git. Las llaves de IA también se pueden
# capturar con un solo comando:  python manage.py configurar_ia

# --- Llaves de la IA ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Base de datos ---
# Si DB_NAME se deja vacío el sistema usa SQLite (db.sqlite3) y no hace falta
# instalar nada. Para usar PostgreSQL llena estos datos (ver database/README.md).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
