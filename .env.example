# Copia este archivo con el nombre ".env" (sin el .example) y llena tus datos.
# El archivo .env NUNCA se sube a git. Las llaves de IA también se pueden
# capturar con un solo comando:  python manage.py configurar_ia

# --- Llaves de la IA ---
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Base de datos ---
# Si DB_NAME se deja vacío el sistema usa SQLite (db.sqlite3) y no hace falta
# instalar nada. Para usar PostgreSQL llena estos datos (ver database/README.md).
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Seguridad (para cuando el sistema se publique) ---
# DJANGO_SECRET_KEY=una-llave-larga-y-secreta
# DJANGO_DEBUG=False
# ALLOWED_HOSTS=127.0.0.1,localhost,midominio.azurewebsites.net
# CSRF_TRUSTED_ORIGINS=https://midominio.azurewebsites.net
# USAR_HTTPS=True

# --- Correo para recuperar la contraseña (si se deja vacío, el correo se imprime en la terminal) ---
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# --- Otros ---
# VIDEO_INTRODUCTORIO_URL=https://www.youtube.com/embed/xxxxxxxx
# PRONOSTICO_MINIMO_DIAS=30
